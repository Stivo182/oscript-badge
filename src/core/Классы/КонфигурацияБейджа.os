#Использовать reflector
#Использовать "../../internal"

// Текст заголовка (левая часть) бейджа
&Сериализуемое("label")
&Тип("Строка")
Перем Заголовок Экспорт; // Строка

// Основное значение бейджа (правая часть)
&Сериализуемое("value")
Перем Значение Экспорт; // Строка, Число

// Текст, добавляемый перед значением. Например, "≈", "$", "v"
&Сериализуемое("valuePrefix")
&Тип("Строка")
Перем ПрефиксЗначения Экспорт; // Строка

// Текст, добавляемый после значения. Например, "%", "ms", "lines"
&Сериализуемое("valueSuffix")
&Тип("Строка")
Перем СуффиксЗначения Экспорт; // Строка

// Стиль оформления бейджа. Доступно: "flat" (по умолчанию), "flat-square", "for-the-badge", "social"
&Сериализуемое("style")
&Тип("Строка")
Перем Стиль Экспорт; // СтилиБейджей

// Имя иконки из каталога assets/icons,
// либо готовый base64-строкой, либо полный data-uri изображения
&Сериализуемое("logo")
&Тип("Строка")
Перем Логотип Экспорт; // Строка

// Цвет текста заголовка в HEX-формате
&Сериализуемое("labelColor")
&Тип("Строка")
Перем ЦветТекстаЗаголовка Экспорт; // Строка

// Цвет текста значения в HEX-формате
&Сериализуемое("valueColor")
&Тип("Строка")
Перем ЦветТекстаЗначения Экспорт; // Строка

// Цвет фона заголовка в HEX-формате
&Сериализуемое("labelBackground")
&Тип("Строка")
Перем ЦветФонаЗаголовка Экспорт; // Строка

// Цвет фона значения в HEX-формате
&Сериализуемое("valueBackground")
&Тип("Строка")
Перем ЦветФонаЗначения Экспорт; // Строка

// Цвет иконки (логотипа)
&Сериализуемое("logoColor")
&Тип("Строка")
Перем ЦветЛоготипа Экспорт; // Строка

// Цвет тени текста заголовка в HEX-формате (flat)
&Сериализуемое("labelShadow")
&Тип("Строка")
Перем ЦветТениЗаголовка Экспорт; // Строка

// Цвет тени текста значения в HEX-формате (flat)
&Сериализуемое("valueShadow")
&Тип("Строка")
Перем ЦветТениЗначения Экспорт; // Строка

// Размер шрифта
&Сериализуемое("fontSize")
&Тип("Число")
Перем РазмерШрифта Экспорт; // Число

// Базовая ширина одного символа для расчёта ширины заголовка
&Сериализуемое("labelCharWidth")
&Тип("Число")
Перем ШиринаСимволаЗаголовка Экспорт; // Число

// Базовая ширина одного символа для расчёта ширины значения
&Сериализуемое("valueCharWidth")
&Тип("Число")
Перем ШиринаСимволаЗначения Экспорт; // Число

// Ширина логотипа
&Сериализуемое("logoWidth")
&Тип("Число")
Перем ШиринаЛоготипа Экспорт; // Число

// Отступ вокруг логотипа (влияет на общую ширину бейджа)
&Сериализуемое("logoPadding")
&Тип("Число")
Перем ОтступЛоготипа Экспорт; // Число

// Дополнительный горизонтальный отступ в долях ширины шрифта внутри блоков заголовка и значения
&Сериализуемое("numPaddingChars")
&Тип("Число")
Перем КоличествоСимволовОтступа Экспорт; // Число

// Коэффициент масштабирования текста
&Сериализуемое("textScale")
&Тип("Число")
Перем МасштабТекста Экспорт; // Строка

// Ссылка загловка (social)
&Сериализуемое("labelLink")
&Тип("Строка")
Перем СсылкаЗаголовка Экспорт; // Строка

// Ссылка значения (social)
&Сериализуемое("valueLink")
&Тип("Строка")
Перем СсылкаЗначения Экспорт; // Строка

// Тип калькулятора геометрии бейджа
&Несериализуемое
Перем ТипКалькулятораГеометрии Экспорт; // Тип

// Конструктор
//
// Параметры:
//   ЗаголовокБейджа - Строка - Текст заголовка бейджа
//   ЗначениеБейджа - Строка, Число - Значение бейджа
//   Цвет - Строка - Цвет фона значения
Процедура ПриСозданииОбъекта(ЗаголовокБейджа = "", ЗначениеБейджа = "", Цвет = "")

	Заголовок = ЗаголовокБейджа;
	Значение = ЗначениеБейджа;
	ПрефиксЗначения = "";
	СуффиксЗначения = "";
	Стиль = СтилиБейджей.Flat;
	Логотип = "";
	ЦветТекстаЗаголовка = "";
	ЦветТекстаЗначения = "";
	ЦветФонаЗаголовка = "";
	ЦветФонаЗначения = Цвет;
	ЦветЛоготипа = "";
	ЦветТениЗаголовка = "";
	ЦветТениЗначения = "";
	РазмерШрифта = 0;
	ШиринаСимволаЗаголовка = 0;
	ШиринаСимволаЗначения = 0;
	ШиринаЛоготипа = 0;
	ОтступЛоготипа = 0;
	КоличествоСимволовОтступа = 0;
	МасштабТекста = 0;
	СсылкаЗаголовка = "";
	СсылкаЗначения = "";

КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Применяет предопределённый стиль к текущей конфигурации
//
// Параметры:
//   ИмяСтиля - СтилиБейджей - Название стиля: "flat", "flat-square", "for-the-badge", "social"
//   Перезаписать - Булево - Если Истина - все свойства будут перезаписаны, даже если уже заполнены.
//                           Если Ложь (по умолчанию) - перезаписываются только пустые свойства.
Процедура ПрименитьСтиль(ИмяСтиля, Перезаписать = Ложь) Экспорт

	КонфигурацияСтиля = КонфигурацияСтиля(ИмяСтиля);

	Рефлектор = Новый РефлекторОбъекта(ЭтотОбъект);
	Свойства = Рефлектор.ПолучитьТаблицуСвойств();

	Для Каждого Свойство Из Свойства Цикл
		
		ПредыдущееЗначение = ЭтотОбъект[Свойство.Имя];
		
		Если Не Перезаписать И ЗначениеЗаполнено(ПредыдущееЗначение) Тогда
			Продолжить;
		КонецЕсли;

		ЭтотОбъект[Свойство.Имя] = КонфигурацияСтиля[Свойство.Имя];

	КонецЦикла;
	
КонецПроцедуры

Функция ПредставлениеЗаголовка() Экспорт

	Представление = Заголовок;

	Если Стиль = СтилиБейджей.ForTheBadge Тогда
		Представление = ВРег(Представление);
	КонецЕсли;

	Возврат Представление;

КонецФункции

Функция ПредставлениеЗначения() Экспорт

	Представление = "" + ПрефиксЗначения + Формат(Значение, "ЧРД=.; ЧН=0; ЧГ=") + СуффиксЗначения;

	Если Стиль = СтилиБейджей.ForTheBadge Тогда
		Представление = ВРег(Представление);
	КонецЕсли;

	Возврат Представление;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КонфигурацияСтиля(ИмяСтиля)

	Если Стиль = СтилиБейджей.Flat Тогда
		Возврат КонфигурацияFlat();
	ИначеЕсли Стиль = СтилиБейджей.FlatSquare Тогда
		Возврат КонфигурацияFlatSquare();
	ИначеЕсли Стиль = СтилиБейджей.ForTheBadge Тогда
		Возврат КонфигурацияForTheBadge();
	ИначеЕсли Стиль = СтилиБейджей.Social Тогда
		Возврат КонфигурацияSocial();
	ИначеЕсли Стиль = СтилиБейджей.GitlabScoped Тогда
		Возврат КонфигурацияGitlabScoped();
	Иначе 
		ВызватьИсключение СтрШаблон("Стиль %1 не поддерживается", Стиль);
	КонецЕсли;

КонецФункции

Функция КонфигурацияFlat()

	Конфигурация = Новый КонфигурацияБейджа();
	Конфигурация.Стиль = СтилиБейджей.Flat;
	Конфигурация.ТипКалькулятораГеометрии = Тип("КалькуляторГеометрииБейджа");
	Конфигурация.ЦветТекстаЗаголовка = "#fff";
	Конфигурация.ЦветТениЗаголовка = "#010101";
	Конфигурация.ЦветФонаЗаголовка = "#555";
	Конфигурация.ЦветТекстаЗначения = "#fff";
	Конфигурация.ЦветТениЗначения = "#010101";
	Конфигурация.ЦветФонаЗначения = "#007ec6";
	Конфигурация.РазмерШрифта = 11;
	Конфигурация.ШиринаСимволаЗаголовка = 10;
	Конфигурация.ШиринаСимволаЗначения = 10;
	Конфигурация.ШиринаЛоготипа = 14;
	Конфигурация.ОтступЛоготипа = 5;
	Конфигурация.МасштабТекста = 0.1;
	Конфигурация.КоличествоСимволовОтступа = 0.5;

	Возврат Конфигурация;

КонецФункции

Функция КонфигурацияFlatSquare()

	Конфигурация = Новый КонфигурацияБейджа();
	Конфигурация.Стиль = СтилиБейджей.FlatSquare;
	Конфигурация.ТипКалькулятораГеометрии = Тип("КалькуляторГеометрииБейджа");
	Конфигурация.ЦветТекстаЗаголовка = "#fff";
	Конфигурация.ЦветФонаЗаголовка = "#555";
	Конфигурация.ЦветТекстаЗначения = "#fff";
	Конфигурация.ЦветФонаЗначения = "#007ec6";
	Конфигурация.РазмерШрифта = 11;
	Конфигурация.ШиринаСимволаЗаголовка = 10;
	Конфигурация.ШиринаСимволаЗначения = 10;
	Конфигурация.ШиринаЛоготипа = 14;
	Конфигурация.ОтступЛоготипа = 5;
	Конфигурация.МасштабТекста = 0.1;
	Конфигурация.КоличествоСимволовОтступа = 0.5;

	Возврат Конфигурация;

КонецФункции

Функция КонфигурацияForTheBadge()

	Конфигурация = Новый КонфигурацияБейджа();
	Конфигурация.Стиль = СтилиБейджей.ForTheBadge;
	Конфигурация.ТипКалькулятораГеометрии = Тип("КалькуляторГеометрииБейджа");
	Конфигурация.ЦветТекстаЗаголовка = "#fff";
	Конфигурация.ЦветФонаЗаголовка = "#555";
	Конфигурация.ЦветТекстаЗначения = "#fff";
	Конфигурация.ЦветФонаЗначения = "#007ec6";
	Конфигурация.РазмерШрифта = 10;
	Конфигурация.ШиринаСимволаЗаголовка = 10;
	Конфигурация.ШиринаСимволаЗначения = 12;
	Конфигурация.ШиринаЛоготипа = 14;
	Конфигурация.ОтступЛоготипа = 9;
	Конфигурация.МасштабТекста = 0.1;
	Конфигурация.КоличествоСимволовОтступа = 1;

	Возврат Конфигурация;

КонецФункции

Функция КонфигурацияSocial()

	Конфигурация = Новый КонфигурацияБейджа();
	Конфигурация.Стиль = СтилиБейджей.Social;
	Конфигурация.ТипКалькулятораГеометрии = Тип("КалькуляторГеометрииБейджаSocial");
