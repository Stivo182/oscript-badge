КонецФункции

Функция КонфигурацияGitlabScoped()

	Конфигурация = Новый КонфигурацияБейджа();
	Конфигурация.Стиль = СтилиБейджей.GitlabScoped;
	Конфигурация.ТипКалькулятораГеометрии = Тип("КалькуляторГеометрииБейджа");
	Конфигурация.ЦветТекстаЗаголовка = "#fff";
	Конфигурация.ЦветФонаЗаголовка = "#c1115d";
	Конфигурация.ЦветТекстаЗначения = "#fff";
	Конфигурация.ЦветФонаЗначения = "#262626";
	Конфигурация.РазмерШрифта = 11;
	Конфигурация.ШиринаСимволаЗаголовка = 9.5;
	Конфигурация.ШиринаСимволаЗначения = 9.5;
	Конфигурация.МасштабТекста = 0.1;
	Конфигурация.КоличествоСимволовОтступа = 0.8;

	Возврат Конфигурация;

КонецФункции

#КонецОбласти