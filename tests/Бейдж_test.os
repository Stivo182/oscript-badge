Процедура ПослеЗапускаТестов() Экспорт
	ВременныеФайлы.Удалить();
КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроверитьГенерациюБейджа() Экспорт
	
	Стили = Новый Массив();
	Стили.Добавить(СтилиБейджей.Flat);
	Стили.Добавить(СтилиБейджей.FlatSquare);
	Стили.Добавить(СтилиБейджей.Plastic);
	Стили.Добавить(СтилиБейджей.ForTheBadge);
	Стили.Добавить(СтилиБейджей.Social);
	Стили.Добавить(СтилиБейджей.GitlabScoped);

	ТестовыеСлучаи = ТестовыеСлучаиКонфигурации();

	Для Каждого ТестовыйСлучай Из ТестовыеСлучаи Цикл

		Для Каждого ИмяСтиля Из Стили Цикл

			// Подготовка
			Конфигурация = ТестовыйСлучай.Ключ;
			Конфигурация.Стиль = ИмяСтиля;

			ПутьКФайлуЭталон = ПолучитьПутьКЭталонномуБейджу(ТестовыйСлучай.Значение, ИмяСтиля);
			ПутьКФайлуТест = ВременныеФайлы.СоздатьФайл("svg");
			
			// Действие
			Бейдж = Новый Бейдж(Конфигурация);
			Бейдж.СохранитьВФайл(ПутьКФайлуТест);
		
			// Утверждение
			Сообщение = СтрШаблон("Стиль: %1, имя: %2", ИмяСтиля, ТестовыйСлучай.Значение);
			ОжидаемЧтоФайлыБейджейСовпадают(ПутьКФайлуЭталон, ПутьКФайлуТест, Сообщение);

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

