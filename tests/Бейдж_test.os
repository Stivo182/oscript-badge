&Тест
Процедура ТестДолжен_ПроверитьУстановкуЦветаЛоготипа() Экспорт
	
	// Подготовка
	Логотипы = Новый Массив();
	Логотипы.Добавить(ЛоготипGithubBase64());
	Логотипы.Добавить("data:image/svg+xml;base64," + ЛоготипGithubBase64());

	Конфигурация = Новый КонфигурацияБейджа("label");
	Конфигурация.ЦветЛоготипа = "red";

	Бейдж = Новый Бейдж(Конфигурация);

	Для Каждого Логотип Из Логотипы Цикл

		Конфигурация.Логотип = Логотип;

		// Действие
		Результат = Бейдж.ПолучитьSVG();
		
		// Утверждение
		Base64 = ИзвлечьBase64ИзSVG(Результат);
		SVG = ПолучитьСтрокуИзДвоичныхДанных(Base64Значение(Base64));

		Ожидаем.Что(SVG).Содержит("xmlns=""http://www.w3.org/2000/svg""><g fill=""red""><title>");
		Ожидаем.Что(SVG).Содержит("</g></svg>");

	КонецЦикла;

КонецПроцедуры

Функция ТестовыеСлучаиКонфигурации()

	Набор = Новый Соответствие();

	// Пустая конфигурация
	Конфигурация = Новый КонфигурацияБейджа();
	Набор.Вставить(Конфигурация, "ПустаяКонфигурация");

	// Заголовок
	Конфигурация = Новый КонфигурацияБейджа();
	Конфигурация.Заголовок = "label";
	Набор.Вставить(Конфигурация, "Заголовок");

	// Заголовок через конструктор
	Конфигурация = Новый КонфигурацияБейджа("label");
	Набор.Вставить(Конфигурация, "Заголовок");

	// Значение
	Конфигурация = Новый КонфигурацияБейджа();
	Конфигурация.Значение = "value";
	Набор.Вставить(Конфигурация, "Значение");

	// Заголовок и значение
	Конфигурация = Новый КонфигурацияБейджа();
	Конфигурация.Заголовок = "label";
	Конфигурация.Значение = "value";
	Набор.Вставить(Конфигурация, "ЗаголовокИЗначение");

	// Заголовок и значение через конструктор
	Конфигурация = Новый КонфигурацияБейджа("label", "value");
	Набор.Вставить(Конфигурация, "ЗаголовокИЗначение");

	// Заголовок и значение на кириллице
	Конфигурация = Новый КонфигурацияБейджа();
	Конфигурация.Заголовок = "Заголовок";
	Конфигурация.Значение = "Значение";
	Набор.Вставить(Конфигурация, "ЗаголовокИЗначениеНаКириллице");

	// Логотип
	Конфигурация = Новый КонфигурацияБейджа();
	Конфигурация.Логотип = "onescript";
	Набор.Вставить(Конфигурация, "Логотип");

	// Логотип base64
	Конфигурация = Новый КонфигурацияБейджа();
	Конфигурация.Логотип = ЛоготипGithubBase64();
	Набор.Вставить(Конфигурация, "ЛоготипBase64");

	// Логотип data-url
	Конфигурация = Новый КонфигурацияБейджа();
	Конфигурация.Логотип = "data:image/svg+xml;base64," + ЛоготипGithubBase64();
	Набор.Вставить(Конфигурация, "ЛоготипDataURL");

	// Логотип и заголовок
	Конфигурация = Новый КонфигурацияБейджа();
	Конфигурация.Заголовок = "label";
	Конфигурация.Логотип = "onescript";
	Набор.Вставить(Конфигурация, "ЛоготипИЗаголовок");

	// Логотип, заголовок и значение
	Конфигурация = Новый КонфигурацияБейджа();
	Конфигурация.Заголовок = "label";
	Конфигурация.Значение = "value";
	Конфигурация.Логотип = "onescript";
	Набор.Вставить(Конфигурация, "ЛоготипЗаголовокИЗначение");

	// Значение и префикс
	Конфигурация = Новый КонфигурацияБейджа(, "2.0.0");
	Конфигурация.ПрефиксЗначения = "v";
	Набор.Вставить(Конфигурация, "ЗначениеИПрефикс");

	// Значение и суффикс
	Конфигурация = Новый КонфигурацияБейджа(, 100);
	Конфигурация.СуффиксЗначения = "%";
	Набор.Вставить(Конфигурация, "ЗначениеИСуффикс");

	// Цвета
	Конфигурация = Новый КонфигурацияБейджа();
	Конфигурация.Заголовок = "label";
	Конфигурация.Значение = "value";
	Конфигурация.ЦветТекстаЗаголовка = "red";
	Конфигурация.ЦветТениЗаголовка = "blue";
	Конфигурация.ЦветФонаЗаголовка = "yellow";
	Конфигурация.ЦветТекстаЗначения = "yellow";
	Конфигурация.ЦветТениЗначения = "red";
	Конфигурация.ЦветФонаЗначения = "blue";
	Набор.Вставить(Конфигурация, "Цвета");

	// Размер шрифта
	Конфигурация = Новый КонфигурацияБейджа();
	Конфигурация.Заголовок = "label";
	Конфигурация.Значение = "value";
	Конфигурация.РазмерШрифта = 8;
	Набор.Вставить(Конфигурация, "РазмерШрифта");

	// Ширина символа
	Конфигурация = Новый КонфигурацияБейджа();
	Конфигурация.Заголовок = "label";
	Конфигурация.Значение = "value";
	Конфигурация.ШиринаСимволаЗаголовка = 20;
	Конфигурация.ШиринаСимволаЗначения = 30;
	Набор.Вставить(Конфигурация, "ШиринаСимвола");

	// Количество смволов отступа
	Конфигурация = Новый КонфигурацияБейджа();
	Конфигурация.Заголовок = "label";
	Конфигурация.Значение = "value";
	Конфигурация.КоличествоСимволовОтступа = 10;
	Набор.Вставить(Конфигурация, "КоличествоСимволовОтступа");

	// Заголовок, значение и цвет через конструктор
	Конфигурация = Новый КонфигурацияБейджа("label", "value", "red");
	Набор.Вставить(Конфигурация, "ЗаголовокЗначениеИЦвет");

	Возврат Набор;
	
КонецФункции

Процедура ОжидаемЧтоФайлыБейджейСовпадают(Путь1, Путь2, Сообщение = "Файлы должны совпадать")

	ЧтениеТекста = Новый ЧтениеТекста(Путь1, КодировкаТекста.UTF8);
	Текст1 = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();
	
	ЧтениеТекста = Новый ЧтениеТекста(Путь2, КодировкаТекста.UTF8);
	Текст2 = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();

	ДанныеБейджа1 = РазделитьБейдж(Текст1);
	ДанныеБейджа2 = РазделитьБейдж(Текст2);

	Ожидаем.Что(ДанныеБейджа1.БейджБезЛоготипа, Сообщение).Равно(ДанныеБейджа2.БейджБезЛоготипа);
	Ожидаем.Что(ДанныеБейджа1.Логотип, Сообщение).Равно(ДанныеБейджа2.Логотип);

КонецПроцедуры

Функция РазделитьБейдж(SVG)

	Base64 = ИзвлечьBase64ИзSVG(SVG);
	Если ЗначениеЗаполнено(Base64) Тогда
		Логотип = ПолучитьСтрокуИзДвоичныхДанных(Base64Значение(Base64));
		БейджБезЛоготипа = СтрЗаменить(SVG, Base64, "");

		Если Не СтрНайти(Логотип, Символы.ВК + Символы.ПС) Тогда
			Логотип = СтрЗаменить(Логотип, Символы.ПС, Символы.ВК + Символы.ПС);
		КонецЕсли;
	Иначе
		Логотип = Неопределено;
		БейджБезЛоготипа = SVG;
	КонецЕсли;

	Результат = Новый Структура();
	Результат.Вставить("Логотип", Логотип);
	Результат.Вставить("БейджБезЛоготипа", БейджБезЛоготипа);

	Возврат Результат;

КонецФункции

Функция ИзвлечьBase64ИзSVG(SVG)

	РегулярноеВыражение = Новый РегулярноеВыражение("data:[^,]*;base64,([A-Za-z0-9+/=]+)");

	Совпадения = РегулярноеВыражение.НайтиСовпадения(SVG);
	Если Совпадения.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат Совпадения[0].Группы[1].Значение;

КонецФункции

Процедура СформироватьЭталонныеФайлы()
	
	Стили = Новый Массив();
	Стили.Добавить(СтилиБейджей.Flat);
	Стили.Добавить(СтилиБейджей.FlatSquare);
	Стили.Добавить(СтилиБейджей.Plastic);
	Стили.Добавить(СтилиБейджей.ForTheBadge);
	Стили.Добавить(СтилиБейджей.Social);
	Стили.Добавить(СтилиБейджей.GitlabScoped);

	ТестовыеСлучаи = ТестовыеСлучаиКонфигурации();

	Для Каждого ТестовыйСлучай Из ТестовыеСлучаи Цикл

		Для Каждого ИмяСтиля Из Стили Цикл

			Конфигурация = ТестовыйСлучай.Ключ;
			Конфигурация.Стиль = ИмяСтиля;

			ПутьКФайлу = ПолучитьПутьКЭталонномуБейджу(ТестовыйСлучай.Значение, ИмяСтиля);
		
			Бейдж = Новый Бейдж(Конфигурация);
			Бейдж.СохранитьВФайл(ПутьКФайлу);

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

Функция ПолучитьПутьКЭталонномуБейджу(Имя, Стиль)
	Возврат СтрШаблон("./tests/fixtures/%1-%2.svg", Имя, Стиль)
КонецФункции

Функция ЭтоBase64(Текст)
	
	Попытка
		Base64Значение(Текст);
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Функция ЛоготипGithubBase64()
	Возврат ""; // BSLLS:LineLength-off
КонецФункции