#Использовать asserts
#Использовать tempfiles
#Использовать "../src/core"

&ПослеВсех
Процедура ПослеЗапускаТестов() Экспорт
	ВременныеФайлы.Удалить();
КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроверитьГенерациюБейджа() Экспорт
	
	Стили = Новый Массив();
	Стили.Добавить(СтилиБейджей.Flat);
	Стили.Добавить(СтилиБейджей.FlatSquare);
	Стили.Добавить(СтилиБейджей.ForTheBadge);
	Стили.Добавить(СтилиБейджей.Social);
	Стили.Добавить(СтилиБейджей.GitlabScoped);

	ТестовыеСлучаи = ТестовыеСлучаиКонфигурации();

	Для Каждого ТестовыйСлучай Из ТестовыеСлучаи Цикл

		Для Каждого ИмяСтиля Из Стили Цикл

			// Подготовка
			Конфигурация = ТестовыйСлучай.Ключ;
			Конфигурация.Стиль = ИмяСтиля;

			ПутьКФайлуЭталон = ПолучитьПутьКЭталонномуБейджу(ТестовыйСлучай.Значение, ИмяСтиля);
			ПутьКФайлуТест = ВременныеФайлы.СоздатьФайл("svg");
			
			// Действие
			Бейдж = Новый Бейдж(Конфигурация);
			Бейдж.СохранитьВФайл(ПутьКФайлуТест);
		
			// Утверждение
			ОжидаемЧтоФайлыСовпадают(ПутьКФайлуЭталон, ПутьКФайлуТест, ТестовыйСлучай.Значение);

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИсключениеПриУстановкеКонфигурацииСНеподдерживаемымСтилем() Экспорт
	
	// Подготовка
	Конфигурация = Новый КонфигурацияБейджа();
	Конфигурация.Стиль = "unknown";

	Бейдж = Новый Бейдж(Конфигурация);

	// Действие и Утверждение
	Ожидаем.Что(Бейдж)
		.Метод("ПолучитьSVG")
		.ВыбрасываетИсключение("Стиль unknown не поддерживается");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИсключениеПриУстановкеНесуществующегоЛоготипа() Экспорт
	
	// Подготовка
	Конфигурация = Новый КонфигурацияБейджа();
	Конфигурация.Логотип = "unknown";

	Бейдж = Новый Бейдж(Конфигурация);

	// Действие и Утверждение
	Ожидаем.Что(Бейдж)
		.Метод("ПолучитьSVG")
		.ВыбрасываетИсключение("Не найден логотип с именем unknown");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПрименитьКонфигурацию() Экспорт
	
	// Подготовка
	Бейдж = Новый Бейдж();
	Конфигурация = Новый КонфигурацияБейджа("label", "value", "red");

	ПутьКФайлуЭталон = ПолучитьПутьКЭталонномуБейджу("ЗаголовокЗначениеИЦвет", "flat");
	ПутьКФайлуТест = ВременныеФайлы.СоздатьФайл("svg");

	// Действие
	Бейдж.ПрименитьКонфигурацию(Конфигурация);
	Бейдж.СохранитьВФайл(ПутьКФайлуТест);

	// Утверждение
	ОжидаемЧтоФайлыСовпадают(ПутьКФайлуЭталон, ПутьКФайлуТест);

КонецПроцедуры

&Тест
